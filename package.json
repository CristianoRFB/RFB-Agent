{
  "name": "rfbagent-quality",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "test:domain": "node --test tests/domain.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-rfbagent --config firebase/firebase.json --only firestore \"node --test firebase/tests/rules.test.mjs\"",
    "test:all": "npm run test:domain && npm run test:rules",
    "test:ui": "playwright test -c playwright.config.mjs",
    "emulators:start": "firebase emulators:start --project demo-rfbagent --config firebase/firebase.json --only auth,firestore",
    "emulators:seed": "node firebase/seed.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^14.0.0",
    "@playwright/test": "^1.64.1",
    "firebase-admin": "^13.0.0"
  }
}
