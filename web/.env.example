# Local test: Firebase Auth + Firestore emulators and Node gateway.
VITE_USE_FIREBASE_EMULATORS=true

# Only after separate written approval and isolated Firebase Spark staging setup:
# VITE_USE_FIREBASE_EMULATORS=false
# VITE_ENABLE_STAGING=true
# VITE_STAGING_COMPANY_ID=alpha
# VITE_FIREBASE_PROJECT_ID=rfbagent-isolated-staging
# VITE_FIREBASE_API_KEY=<PUBLIC_FIREBASE_BROWSER_API_KEY>
# VITE_FIREBASE_AUTH_DOMAIN=<STAGING_PROJECT>.firebaseapp.com
# VITE_FIREBASE_APP_ID=<PUBLIC_FIREBASE_APP_ID>
# Never put service-account keys in a VITE_ variable or Git.
